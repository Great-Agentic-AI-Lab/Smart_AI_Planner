# Smart AI Planner - Environment Variables
# Copy this to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://planner_user:planner_password@localhost/smart_planner_db

# Google AI (Gemini) - REQUIRED
GOOGLE_API_KEY=your_google_api_key_here

# Perplexity AI (Optional - LLM fallback)
# Get free API key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here_optional

# Pinecone Vector Database - REQUIRED
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=smart-planner

# Telegram Bot - REQUIRED
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Security
SECRET_KEY=change-this-to-random-string-in-production

# App Config
APP_NAME=Smart Personal Planner
DEBUG=False